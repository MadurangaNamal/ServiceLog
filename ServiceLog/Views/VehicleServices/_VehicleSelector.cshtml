@model IEnumerable<Vehicle>?

<div class="dropdown vehicle-selector">
    <button class="vehicle-selector-btn dropdown-toggle d-flex align-items-center
        justify-content-between gap-2 w-100"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-car-front text-primary"></i>
            @{
                var currentVehicleId = ViewBag.SelectedVehicleId as int?;
                var selected = Model?.FirstOrDefault(v => v.Id == currentVehicleId) ?? Model?.FirstOrDefault();
            }
            <span>
                @(selected != null
                    ? $"{selected.Brand} {selected.Model} — {selected.Year}"
                    : "Select a vehicle")
            </span>
        </div>
        <i class="bi bi-chevron-down opacity-50"></i>
    </button>

    <ul class="dropdown-menu dropdown-menu-end vehicle-dropdown w-100">
        @if (Model != null)
        {
            foreach (var v in Model)
            {
                <li>
                    <div class="dropdown-item-vehicle d-flex align-items-center
                        justify-content-between">
                        <a class="vehicle-option flex-grow-1 d-flex align-items-center gap-2"
                               asp-controller="VehicleServices"
                               asp-action="Index"
                               asp-route-vehicleId="@v.Id">
                            @{
                                var isSelected = v.Id == selected?.Id;
                            }

                            @if (isSelected)
                            {
                                <i class="bi bi-check2 text-primary"></i>
                            }
                            else
                            {
                                <span style="width:16px;display:inline-block;"></span>
                            }
                            <span>@v.Brand @v.Model — @v.Year</span>
                        </a>
                        <a asp-controller="Vehicles"
                               asp-action="UpdateVehicle"
                               asp-route-id="@v.Id"
                               class="vehicle-edit-btn"
                               title="Edit vehicle">
                            <i class="bi bi-wrench text-muted"></i>
                        </a>
                    </div>
                </li>
            }
        }
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2 text-primary"
                   asp-controller="Vehicles"
                   asp-action="AddNewVehicle">
                <i class="bi bi-plus-circle"></i>
                <span>Add vehicle</span>
            </a>
        </li>
    </ul>
</div>