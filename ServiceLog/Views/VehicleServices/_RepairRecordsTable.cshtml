@model IEnumerable<ServiceRecord>

@{
    const int pageSize = 5;
    var records = Model?.ToList() ?? [];
    var totalCost = records.Sum(r => r.Cost);
    var showPagination = records.Count > pageSize;
}

<div class="records-card" id="repairRecordsCard" data-page-size="@pageSize">
    <div class="records-card__header">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-wrench text-primary"></i>
            <span class="text-primary fw-semibold">Repair History</span>
        </div>
        <span class="records-card__total font-monospace">
            Total: <span class="text-primary fw-semibold">@totalCost.ToString("N2") AED</span>
        </span>
    </div>

    @if (!records.Any())
    {
        <div class="records-card__empty">No repair records found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table records-table mb-0">
                <thead>
                    <tr>
                        <th class="text-primary-emphasis">Date</th>
                        <th class="text-primary-emphasis">Type</th>
                        <th class="text-primary-emphasis">Notes</th>
                        <th class="text-primary-emphasis">Mileage</th>
                        <th class="text-primary-emphasis">Cost</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < records.Count; i++)
                    {
                        var r = records[i];
                        <tr data-repair-row>
                            <td class="font-monospace small">
                                @r.ServiceDate.ToString("yyyy-MM-dd")
                            </td>
                            <td>
                                <span class="service-badge service-badge--@r.ServiceType.ToString().ToLower()">
                                    @r.ServiceType.ToString()
                                </span>
                            </td>
                            <td class="text-muted small">@(r.Notes ?? "—")</td>
                            <td class="font-monospace small">
                                @r.CurrentMileage.ToString("N0")
                            </td>
                            <td class="font-monospace small fw-semibold">
                                @r.Cost.ToString("N2") AED
                            </td>
                            <td class="text-end">

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@r.Id"
                                        data-description="@($"{r.ServiceType} - {r.ServiceDate:yyyy-MM-dd}")"
                                        data-delete-url="/VehicleServices/Delete">

                                    <i class="bi bi-trash"></i>
                                </button>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (showPagination)
        {
            <div class="records-card__pagination">
                <span class="records-pagination__info" data-pagination-info></span>
                <nav aria-label="Repair records pagination">
                    <ul class="pagination pagination-sm records-pagination mb-0">
                        <li class="page-item">
                            <button type="button" class="page-link" data-page-prev aria-label="Previous page">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>
                        <li class="page-item">
                            <span class="page-link records-pagination__current" data-pagination-page></span>
                        </li>
                        <li class="page-item">
                            <button type="button" class="page-link" data-page-next aria-label="Next page">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

@if (showPagination)
{
    <script src="~/js/pagination.js" asp-append-version="true"></script>
}
