@model ServiceDashboardViewModel;

@{
    ViewData["Title"] = "Dashboard";
    var vehicle = Model.Vehicle;
    var records = Model.ServiceRecords?.OrderByDescending(r => r.ServiceDate).ToList()
                  ?? new List<ServiceRecord>();
    var totalCost = records.Sum(r => r.Cost);
}

@section Styles {
    <link rel="stylesheet" href="~/css/serviceDashboard.css" />
}

<div class="min-vh-100 bg-dark-surface p-3 p-md-4">
    <div class="mx-auto dashboard-container">

        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-2">
                <div class="user-avatar">
                    <i class="bi bi-person-fill text-primary"></i>
                </div>
                <span class="text-sm fw-medium">@User.Identity?.Name</span>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </button>
            </form>
        </div>

        <div class="d-flex flex-column flex-sm-row align-items-sm-center
            justify-content-sm-between gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-car-front-fill bs-emphasis-color"></i>
                    <h1 class="dashboard-title mb-0">Service Dashboard</h1>
                </div>
                @if (vehicle != null)
                {
                    <p class="text- small mb-0">
                        @vehicle.Year @vehicle.Brand @vehicle.Model· @vehicle.Mileage.ToString("N0") km
                    </p>
                }
            </div>

            @await Html.PartialAsync("_VehicleSelector", Model.Vehicles)
        </div>

        @await Html.PartialAsync("_ServiceSummaryCards", vehicle)

        @if (vehicle != null)
        {
            <div class="text-end mb-2">
                <a asp-controller="VehicleServices" asp-action="CreateServiceRecord" asp-route-vehicleId="@vehicle.Id" class="btn btn-success">
                    <i class="bi bi-file-earmark-plus"></i> New service record
                </a>
            </div>
        }

        @await Html.PartialAsync("_RepairRecordsTable", records)
    </div>
</div>