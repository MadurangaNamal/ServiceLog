@model ServiceRecord;

@{
    ViewData["Title"] = "New Service Record";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card-dark p-4 shadow">
            <h3 class="text-center mb-4">
                <i class="bi bi-file-earmark-medical-fill"></i>
                Service Record
            </h3>
            <section>
                <form asp-controller="VehicleServices" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <input asp-for="VehicleId" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="ServiceType" class="form-label">
                            Type <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ServiceType"
                                class="form-select"
                                aria-required="true"
                                asp-items="Html.GetEnumSelectList<ServiceType>()">
                            <option value="" selected disabled>-- Select Type --</option>
                        </select>
                        <span asp-validation-for="ServiceType" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ServiceDate" class="form-label">
                            Date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ServiceDate" class="form-control" type="date"/>
                        <span asp-validation-for="ServiceDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CurrentMileage" class="form-label">
                            Current Mileage<span class="text-danger">*</span>
                        </label>
                        <input asp-for="CurrentMileage" type="number" class="form-control" placeholder="e.g. 20000" />
                        <span asp-validation-for="CurrentMileage" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Cost" class="form-label">
                            Cost <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Cost" class="form-control" placeholder="e.g. 250.00" />
                        <span asp-validation-for="Cost" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">
                            Notes
                        </label>
                        <input asp-for="Notes" class="form-control" placeholder="Other comments"/>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="VehicleServices" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Create
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>
