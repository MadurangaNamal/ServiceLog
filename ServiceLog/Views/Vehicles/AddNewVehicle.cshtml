@model Vehicle;

@{
    ViewData["Title"] = "New Vehicle";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card-dark p-4 shadow">
            <h3 class="text-center mb-4">
                <i class="bi bi-car-front-fill"></i>
                New vehicle
            </h3>
            <section>
                <form asp-controller="Vehicles" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Model" class="form-label">
                            Model <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Model" class="form-control" aria-required="true" placeholder="Corolla, Civic.." />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Brand" class="form-label">
                            Brand
                        </label>
                        <input asp-for="Brand" class="form-control" placeholder="Toyota, Honda etc.." />
                        <span asp-validation-for="Brand" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">
                            Category<span class="text-danger">*</span>
                        </label>
                        <select asp-for="Category"
                                class="form-select"
                                aria-required="true"
                                asp-items="Html.GetEnumSelectList<Category>()">
                            <option value="" selected disabled>-- Select Category --</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RegistrationNumber" class="form-label">
                            Registration Number <span class="text-danger">*</span>
                        </label>
                        <input asp-for="RegistrationNumber" class="form-control" aria-required="true" placeholder="Registration number" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Year" class="form-label">
                            Year
                        </label>
                        <input asp-for="Year" type="number" class="form-control" placeholder="e.g. 2020" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Mileage" class="form-label">
                            Mileage
                        </label>
                        <input asp-for="Mileage" type="number" class="form-control" placeholder="e.g. 45000" />
                        <span asp-validation-for="Mileage" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EngineNumber" class="form-label">
                            Engine Number
                        </label>
                        <input asp-for="EngineNumber" class="form-control" placeholder="Enter engine number" />
                        <span asp-validation-for="EngineNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChassisNumber" class="form-label">
                            Chassis Number
                        </label>
                        <input asp-for="ChassisNumber" class="form-control" placeholder="Enter chassis number" />
                        <span asp-validation-for="ChassisNumber" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="VehicleServices" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Create
                        </button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>
